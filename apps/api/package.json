{
  "name": "@ga4fake/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend for the GA4 fake dataset installer: Google sign-in, project listing, install steps.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google-cloud/resource-manager": "^7.1.0",
    "@googleapis/bigquery": "^26.0.0",
    "@googleapis/cloudbilling": "^14.0.1",
    "@googleapis/cloudscheduler": "^11.0.0",
    "@googleapis/iam": "^41.0.0",
    "@googleapis/orgpolicy": "^11.0.1",
    "@googleapis/run": "^37.0.0",
    "@googleapis/serviceusage": "^27.0.0",
    "@hono/node-server": "^2.1.1",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
