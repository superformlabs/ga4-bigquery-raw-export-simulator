# Copy this file to apps/api/.env and fill in the values. Never commit .env.

# OAuth client of type "Web application" in the Google Cloud console
# (project your-project-id, client "local dev"; see task USER-2).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorised redirect URI" on that OAuth client,
# port included. That is why the API port is fixed at 3001 in development.
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback
PORT=3001

# Where the browser is sent after signing in: the UI's origin.
APP_URL=http://localhost:3000

# Key material for encrypting the session cookie. Any long random string.
# Optional in development (a random one is used per run); required in
# production. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Full name of the generator container image the visitor's Cloud Run job
# pulls. Optional in the repository: when unset, the server reads infra/IMAGE
# (written by the deploy role). Required once the API runs outside the repo.
# GENERATOR_IMAGE=us-central1-docker.pkg.dev/your-project-id/ga4synth/ga4synth:<tag>

# Sign-in allowlist (decision D-16). Both are optional, comma separated, and
# compared without regard to case. When either is set, only a Google account
# whose address is listed in ALLOWED_EMAILS, or whose domain is listed in
# ALLOWED_EMAIL_DOMAINS, may sign in. Everyone else lands on
# APP_URL/?error=ACCOUNT_NOT_ALLOWED. Leave both empty to admit every Google
# account (dev and production). Staging sets the domain to superformlabs.eu.
# ALLOWED_EMAIL_DOMAINS=superformlabs.eu
# ALLOWED_EMAILS=

# The address a visitor writes to (decision D-35, contract v1.17). Every
# hint that asks to report a problem names it. Optional: the default is
# support@superformlabs.eu. A value that is not one email address stops the
# server at start.
# SUPPORT_EMAIL=support@superformlabs.eu

# The uninstall is taken out of the app for now (decision D-30, contract
# v1.13). Leave this out: POST /api/install/uninstall then answers 404 and
# the preflight does not test the permissions of the uninstall. Set to true
# only to bring the feature back. Any other value than true or false stops
# the server at start.
# UNINSTALL_ENABLED=false

# Set to true when the API is served over HTTPS. Defaults to true when
# NODE_ENV=production, false otherwise (plain-http localhost).
# COOKIE_SECURE=false
